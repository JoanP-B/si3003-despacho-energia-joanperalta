# Entorno virtual
.venv/
venv/
env/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/

# Secretos / API keys
.env
*.key

# Datos crudos pesados (mantener instrucciones de descarga, no los binarios grandes)
data/raw/*.csv
data/raw/*.parquet
!data/raw/.gitkeep
# Respaldo de XM (plan B): se versiona para que el notebook corra sin la API.
!data/raw/xm_precio_bolsa.csv

# Índices vectoriales generados (se reconstruyen con: python -m src.rag.vectorstore)
*.faiss
*.index
.chroma/
data/processed/faiss_index/

# PDFs del corpus: se ignoran por defecto, salvo los que indexa el RAG (versionados para
# que el índice se reconstruya sin descargas manuales).
corpus_regulacion/*.pdf
!corpus_regulacion/.gitkeep
!corpus_regulacion/Creg174-2021.pdf

# SO / editor
.DS_Store
Thumbs.db
.vscode/

# Los artefactos de la Parte 1 (q_table.json, politica_referencia.json,
# precios_evaluacion.csv) se versionan: pesan < 100 KB y permiten abrir el dashboard sin
# reentrenar. Se regeneran con notebooks/02_mdp_rl.ipynb.